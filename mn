<!DOCTYPE html>
<html lang="ckb" dir="rtl">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>ئەزموونی ئای ئۆ ئیس (iOS Web Experience)</title>
    <style>
        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
            font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
            user-select: none;
        }

        body {
            background: linear-gradient(135deg, #1e1b4b, #311042, #0f172a);
            background-size: 400% 400%;
            animation: gradientBG 15s ease infinite;
            height: 100vh;
            display: flex;
            justify-content: center;
            align-items: center;
            overflow: hidden;
        }

        @keyframes gradientBG {
            0% { background-position: 0% 50%; }
            50% { background-position: 100% 50%; }
            100% { background-position: 0% 50%; }
        }

        /* Phone Frame - قەبارەی گونجاو و بچووکتر بۆ ئەوەی هەمووی دیار بێت */
        .iphone-frame {
            width: 340px;
            height: 680px;
            background: #000;
            border-radius: 40px;
            box-shadow: 0 25px 60px rgba(0,0,0,0.7), inset 0 0 10px rgba(255,255,255,0.2);
            position: relative;
            overflow: hidden;
            border: 8px solid #2b2b2b;
            display: flex;
            flex-direction: column;
        }

        /* Screen Wallpaper */
        .iphone-screen {
            flex: 1;
            background: url('https://images.unsplash.com/photo-1618005182384-a83a8bd57fbe?auto=format&fit=crop&w=800&q=80') no-repeat center center/cover;
            position: relative;
            display: flex;
            flex-direction: column;
            justify-content: space-between;
            padding: 10px 15px 15px 15px;
            overflow: hidden;
        }

        /* Status Bar */
        .status-bar {
            display: flex;
            justify-content: space-between;
            align-items: center;
            color: #fff;
            font-size: 13px;
            font-weight: 600;
            z-index: 100;
            padding: 0 5px;
            height: 25px;
        }

        /* Dynamic Island */
        .dynamic-island {
            position: absolute;
            top: 6px;
            left: 50%;
            transform: translateX(-50%);
            width: 100px;
            height: 24px;
            background: #000;
            border-radius: 16px;
            z-index: 101;
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 0 8px;
            cursor: pointer;
            transition: all 0.3s cubic-bezier(0.175, 0.885, 0.32, 1.275);
        }

        .dynamic-island.expanded {
            width: 240px;
            height: 45px;
            border-radius: 22px;
            background: rgba(0, 0, 0, 0.9);
        }

        .island-dot {
            width: 8px;
            height: 8px;
            background: #10b981;
            border-radius: 50%;
            box-shadow: 0 0 8px #10b981;
        }

        .island-text {
            color: white;
            font-size: 10px;
            display: none;
        }

        .dynamic-island.expanded .island-text {
            display: block;
        }

        /* Home Screen Apps Grid */
        .home-grid {
            display: grid;
            grid-template-columns: repeat(4, 1fr);
            gap: 15px 10px;
            padding: 10px 0;
            z-index: 10;
        }

        .app-icon {
            display: flex;
            flex-direction: column;
            align-items: center;
            cursor: pointer;
            transition: transform 0.15s ease;
        }

        .app-icon:active {
            transform: scale(0.9);
        }

        .app-logo {
            width: 52px;
            height: 52px;
            border-radius: 12px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 22px;
            box-shadow: 0 6px 12px rgba(0,0,0,0.3);
            margin-bottom: 4px;
        }

        .app-title {
            color: #fff;
            font-size: 10px;
            text-shadow: 0 1px 3px rgba(0,0,0,0.8);
            font-weight: 500;
        }

        /* Dock */
        .dock {
            background: rgba(255, 255, 255, 0.2);
            backdrop-filter: blur(20px);
            -webkit-backdrop-filter: blur(20px);
            border-radius: 24px;
            padding: 10px 12px;
            display: flex;
            justify-content: space-around;
            align-items: center;
            z-index: 10;
            margin-bottom: 6px;
            border: 1px solid rgba(255,255,255,0.25);
        }

        .dock .app-logo {
            width: 48px;
            height: 48px;
            margin-bottom: 0;
        }

        /* Home Indicator */
        .home-indicator {
            width: 110px;
            height: 4px;
            background: rgba(255, 255, 255, 0.8);
            border-radius: 10px;
            align-self: center;
            cursor: pointer;
            z-index: 105;
        }

        /* Opened App Window */
        .app-window {
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: #0f172a;
            z-index: 200;
            display: flex;
            flex-direction: column;
            transform: translateY(100%);
            transition: transform 0.4s cubic-bezier(0.16, 1, 0.3, 1);
        }

        .app-window.active {
            transform: translateY(0);
        }

        .app-header {
            padding: 12px 15px;
            background: rgba(15, 23, 42, 0.9);
            border-bottom: 1px solid rgba(255,255,255,0.1);
            display: flex;
            justify-content: space-between;
            align-items: center;
            color: #fff;
            font-size: 16px;
            font-weight: bold;
        }

        .back-btn {
            background: rgba(255,255,255,0.1);
            border: none;
            color: #38bdf8;
            padding: 4px 10px;
            border-radius: 15px;
            cursor: pointer;
            font-size: 13px;
        }

        .app-content {
            flex: 1;
            padding: 15px;
            overflow-y: auto;
            color: #f8fafc;
        }

        /* Calculator App Specific Design */
        .calc-display {
            background: rgba(0,0,0,0.4);
            font-size: 2rem;
            text-align: left;
            padding: 15px;
            border-radius: 10px;
            margin-bottom: 15px;
            color: #fff;
            overflow: hidden;
        }

        .calc-grid {
            display: grid;
            grid-template-columns: repeat(4, 1fr);
            gap: 10px;
        }

        .calc-btn {
            background: #334155;
            color: #fff;
            border: none;
            padding: 14px;
            font-size: 1.1rem;
            border-radius: 50%;
            cursor: pointer;
            display: flex;
            align-items: center;
            justify-content: center;
            transition: 0.2s;
        }

        .calc-btn.orange {
            background: #f59e0b;
        }

        .calc-btn.gray {
            background: #64748b;
            color: #000;
        }

        /* Notes App Specific Design */
        .notes-input {
            width: 100%;
            background: rgba(255,255,255,0.08);
            border: 1px solid rgba(255,255,255,0.2);
            border-radius: 8px;
            padding: 10px;
            color: #fff;
            font-size: 0.95rem;
            margin-bottom: 12px;
            resize: none;
            height: 80px;
        }

        .note-item {
            background: rgba(255,255,255,0.06);
            padding: 10px;
            border-radius: 8px;
            margin-bottom: 8px;
            border-right: 4px solid #f59e0b;
        }
    </style>
</head>
<body>

    <div class="iphone-frame">
        <div class="iphone-screen">
            <!-- Status Bar & Dynamic Island -->
            <div class="status-bar">
                <span id="clock">9:41</span>
                <div class="dynamic-island" onclick="toggleIsland()">
                    <div class="island-dot"></div>
                    <span class="island-text">سیستم ئامادەیە ✓</span>
                </div>
                <span>5G 🔋</span>
            </div>

            <!-- Home Screen Apps -->
            <div class="home-grid">
                <div class="app-icon" onclick="openApp('calcApp')">
                    <div class="app-logo" style="background: linear-gradient(135deg, #f59e0b, #d97706);">🧮</div>
                    <span class="app-title">ژمێرکار</span>
                </div>
                <div class="app-icon" onclick="openApp('notesApp')">
                    <div class="app-logo" style="background: linear-gradient(135deg, #eab308, #ca8a04);">📝</div>
                    <span class="app-title">تێبینییەکان</span>
                </div>
                <div class="app-icon" onclick="openApp('settingsApp')">
                    <div class="app-logo" style="background: linear-gradient(135deg, #64748b, #334155);">⚙️</div>
                    <span class="app-title">ڕێکخستن</span>
                </div>
                <div class="app-icon" onclick="openApp('photosApp')">
                    <div class="app-logo" style="background: linear-gradient(135deg, #ec4899, #be185d);">🖼️</div>
                    <span class="app-title">وێنەکان</span>
                </div>
            </div>

            <!-- Dock -->
            <div class="dock">
                <div class="app-icon" onclick="openApp('phoneApp')">
                    <div class="app-logo" style="background: #10b981;">📞</div>
                </div>
                <div class="app-icon" onclick="openApp('safariApp')">
                    <div class="app-logo" style="background: #3b82f6;">🌐</div>
                </div>
                <div class="app-icon" onclick="openApp('musicApp')">
                    <div class="app-logo" style="background: #ef4444;">🎵</div>
                </div>
            </div>

            <!-- Home Indicator Bar -->
            <div class="home-indicator" onclick="closeAllApps()"></div>
        </div>
    </div>

    <!-- CALC APP WINDOW -->
    <div id="calcApp" class="app-window">
        <div class="app-header">
            <span>ژمێرکار (Calculator)</span>
            <button class="back-btn" onclick="closeAllApps()">داخستن</button>
        </div>
        <div class="app-content">
            <div class="calc-display" id="calcDisplay">0</div>
            <div class="calc-grid">
                <button class="calc-btn gray" onclick="clearCalc()">C</button>
                <button class="calc-btn gray" onclick="appendCalc('%')">%</button>
                <button class="calc-btn gray" onclick="appendCalc('/')">÷</button>
                <button class="calc-btn orange" onclick="appendCalc('*')">×</button>
                <button class="calc-btn" onclick="appendCalc('7')">7</button>
                <button class="calc-btn" onclick="appendCalc('8')">8</button>
                <button class="calc-btn" onclick="appendCalc('9')">9</button>
                <button class="calc-btn orange" onclick="appendCalc('-')">-</button>
                <button class="calc-btn" onclick="appendCalc('4')">4</button>
                <button class="calc-btn" onclick="appendCalc('5')">5</button>
                <button class="calc-btn" onclick="appendCalc('6')">6</button>
                <button class="calc-btn orange" onclick="appendCalc('+')">+</button>
                <button class="calc-btn" onclick="appendCalc('1')">1</button>
                <button class="calc-btn" onclick="appendCalc('2')">2</button>
                <button class="calc-btn" onclick="appendCalc('3')">3</button>
                <button class="calc-btn orange" onclick="calculateResult()">=</button>
                <button class="calc-btn" onclick="appendCalc('0')" style="grid-column: span 2;">0</button>
                <button class="calc-btn" onclick="appendCalc('.')">.</button>
            </div>
        </div>
    </div>

    <!-- NOTES APP WINDOW -->
    <div id="notesApp" class="app-window">
        <div class="app-header">
            <span>تێبینییەکان (Notes)</span>
            <button class="back-btn" onclick="closeAllApps()">داخستن</button>
        </div>
        <div class="app-content">
            <textarea id="noteText" class="notes-input" placeholder="تێبینییەکی نوێ بنووسە..."></textarea>
            <button class="back-btn" style="background:#f59e0b; color:#000; width:100%; padding:8px; margin-bottom:12px; font-weight:bold;" onclick="addNote()">پاشەکەوتکردن</button>
            <div id="notesList"></div>
        </div>
    </div>

    <!-- SETTINGS APP WINDOW -->
    <div id="settingsApp" class="app-window">
        <div class="app-header">
            <span>ڕێکخستنەکان (Settings)</span>
            <button class="back-btn" onclick="closeAllApps()">داخستن</button>
        </div>
        <div class="app-content">
            <div style="background: rgba(255,255,255,0.06); padding: 12px; border-radius: 10px; margin-bottom: 10px;">
                <strong>سیستم:</strong> iOS Web Experience 17.5
            </div>
            <div style="background: rgba(255,255,255,0.06); padding: 12px; border-radius: 10px; margin-bottom: 10px;">
                <strong>دۆخی شاشە:</strong> تاریک (Dark Mode)
            </div>
            <div style="background: rgba(255,255,255,0.06); padding: 12px; border-radius: 10px;">
                <strong>پەرەپێدەر:</strong> تۆ بەڕێزت 🚀
            </div>
        </div>
    </div>

    <!-- PHOTOS APP WINDOW -->
    <div id="photosApp" class="app-window">
        <div class="app-header">
            <span>وێنەکان (Photos)</span>
            <button class="back-btn" onclick="closeAllApps()">داخستن</button>
        </div>
        <div class="app-content" style="display: grid; grid-template-columns: 1fr 1fr; gap: 8px;">
            <img src="https://images.unsplash.com/photo-1507525428034-b723cf961d3e?auto=format&fit=crop&w=400&q=80" style="width:100%; height:100px; object-fit:cover; border-radius:8px;">
            <img src="https://images.unsplash.com/photo-1519681393784-d120267933ba?auto=format&fit=crop&w=400&q=80" style="width:100%; height:100px; object-fit:cover; border-radius:8px;">
            <img src="https://images.unsplash.com/photo-1470071459604-3b5ec3a7fe05?auto=format&fit=crop&w=400&q=80" style="width:100%; height:100px; object-fit:cover; border-radius:8px;">
            <img src="https://images.unsplash.com/photo-1426604966848-d7adac902bff?auto=format&fit=crop&w=400&q=80" style="width:100%; height:100px; object-fit:cover; border-radius:8px;">
        </div>
    </div>

    <!-- DUMMY APPS (Phone, Safari, Music) -->
    <div id="phoneApp" class="app-window"><div class="app-header"><span>پەیوەندی</span><button class="back-btn" onclick="closeAllApps()">داخستن</button></div><div class="app-content"><p style="text-align:center; margin-top:40px;">ژمارەیەک لێرە لێبدە...</p></div></div>
    <div id="safariApp" class="app-window"><div class="app-header"><span>سەفاری</span><button class="back-btn" onclick="closeAllApps()">داخستن</button></div><div class="app-content"><p style="text-align:center; margin-top:40px;">گەڕان لە ئینتەرنێتدا...</p></div></div>
    <div id="musicApp" class="app-window"><div class="app-header"><span>مۆسیقا</span><button class="back-btn" onclick="closeAllApps()">داخستن</button></div><div class="app-content"><p style="text-align:center; margin-top:40px;">لێرە مۆسیقا لێبدە...</p></div></div>

    <script>
        // Clock Update
        function updateClock() {
            const now = new Date();
            let hours = now.getHours();
            let minutes = now.getMinutes();
            minutes = minutes < 10 ? '0' + minutes : minutes;
            document.getElementById('clock').innerText = hours + ':' + minutes;
        }
        setInterval(updateClock, 1000);
        updateClock();

        // Dynamic Island Toggle
        function toggleIsland() {
            const island = document.querySelector('.dynamic-island');
            island.classList.toggle('expanded');
        }

        // Open App
        function openApp(appId) {
            document.getElementById(appId).classList.add('active');
        }

        // Close All Apps
        function closeAllApps() {
            const windows = document.querySelectorAll('.app-window');
            windows.forEach(win => win.classList.remove('active'));
        }

        // Calculator Logic
        let calcExpr = "";
        function appendCalc(val) {
            calcExpr += val;
            document.getElementById('calcDisplay').innerText = calcExpr;
        }
        function clearCalc() {
            calcExpr = "";
            document.getElementById('calcDisplay').innerText = "0";
        }
        function calculateResult() {
            try {
                let res = eval(calcExpr);
                document.getElementById('calcDisplay').innerText = res;
                calcExpr = res.toString();
            } catch (e) {
                document.getElementById('calcDisplay').innerText = "هەڵە";
                calcExpr = "";
            }
        }

        // Notes Logic
        function addNote() {
            const text = document.getElementById('noteText').value;
            if(!text) return;
            const list = document.getElementById('notesList');
            const item = document.createElement('div');
            item.className = 'note-item';
            item.innerText = text;
            list.prepend(item);
            document.getElementById('noteText').value = "";
        }
    </script>
</body>
</html>
